---
import { Comments, CommentForm } from "emdash/ui/comments";
import { getCollectionInfo, getEmDashEntry, getSeoMeta, getSiteSettings, getTermsForEntries } from "emdash";
import Layout from "../../layouts/RoadmapLayout.astro";
import VoteButton from "../../components/VoteButton.astro";
import { strings } from "../../lib/roadmap-strings";
import "../../styles/wbcom-base.css";
import "../../styles/roadmap.css";

const slug = Astro.params.slug || "";
const settings = await getSiteSettings();
const { entry, cacheHint } = slug ? await getEmDashEntry("roadmap", slug) : { entry: null, cacheHint: undefined };
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

const live = entry && (entry.data.status === "published" || !entry.data.status);
if (!live) Astro.response.status = 404;

const seo = live
	? getSeoMeta(entry, {
			siteTitle: settings?.title || strings.boardTitle,
			siteUrl: Astro.url.origin,
			path: Astro.url.pathname.replace(/\/$/, ""),
		})
	: {
			title: strings.itemMissingTitle,
			description: strings.itemMissingHint,
			canonical: null,
			ogTitle: strings.itemMissingTitle,
			ogImage: null,
		};

const info = await getCollectionInfo("roadmap").catch(() => null);
const commentsOn = Boolean(info?.commentsEnabled);
const title = live ? String(entry.data.title || "") : strings.itemMissingTitle;
const description = live ? String(entry.data.description || "") : "";
const stage = live ? String(entry.data.stage || "") : "";
const id = live ? String(entry.data.id || "") : "";
const category = id
	? ((await getTermsForEntries("roadmap", [id], "roadmap_category").catch(() => new Map())).get(id)?.[0]?.label ?? "")
	: "";
---

<Layout
	title={seo.title || title}
	pageTitle={seo.ogTitle || title}
	description={seo.description}
	canonical={seo.canonical}
	image={seo.ogImage}
	content={live ? { collection: "roadmap", id, slug } : undefined}
>
	<div class="wb roadmap">
		<p><a class="wb-btn wb-btn--quiet" href="/roadmap/">{strings.backToBoard}</a></p>
		{
			!live ? (
				<div class="wb-empty">
					<h1>{strings.itemMissingTitle}</h1>
					<p>{strings.itemMissingHint}</p>
				</div>
			) : (
				<article class="roadmap-item">
					<header>
						{stage || category ? (
							<p class="roadmap-item__meta">
								{stage ? <span class="wb-muted">{stage}</span> : null}
								{category ? <span class="roadmap-card-tag">{category}</span> : null}
							</p>
						) : null}
						<h1>{title}</h1>
					</header>
					<p id="roadmap-status" class="wb-status" hidden></p>
					{description ? <p class="roadmap-item__body">{description}</p> : null}
					<VoteButton id={id} title={title} />
					{
						commentsOn ? (
							<section class="roadmap-item__comments">
								<Comments collection="roadmap" contentId={id} threaded />
								<CommentForm collection="roadmap" contentId={id} />
							</section>
						) : (
							<p class="wb-muted">{strings.commentsClosed}</p>
						)
					}
				</article>
			)
		}
	</div>
</Layout>
