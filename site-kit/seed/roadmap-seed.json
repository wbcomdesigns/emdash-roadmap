{
	"version": "1",
	"meta": {
		"name": "Product Roadmap",
		"description": "The roadmap and changelog collections and roadmap categories."
	},
	"collections": [
		{
			"slug": "roadmap",
			"label": "Roadmap",
			"labelSingular": "Roadmap item",
			"description": "Public roadmap items people can vote on",
			"icon": "map",
			"urlPattern": "/roadmap/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"preview",
				"seo"
			],
			"commentsEnabled": true,
			"admin": {
				"listColumns": [
					"stage"
				]
			},
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "description",
					"label": "Description",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "stage",
					"label": "Stage (set it in the Stage panel)",
					"type": "string",
					"indexed": true,
					"defaultValue": "Under review"
				}
			]
		},
		{
			"slug": "changelog",
			"label": "Changelog",
			"labelSingular": "Release",
			"description": "What shipped",
			"icon": "list",
			"urlPattern": "/changelog/{slug}",
			"supports": [
				"drafts",
				"revisions",
				"seo"
			],
			"fields": [
				{
					"slug": "title",
					"label": "Title",
					"type": "string",
					"required": true,
					"searchable": true
				},
				{
					"slug": "summary",
					"label": "Summary",
					"type": "text",
					"searchable": true
				},
				{
					"slug": "released",
					"label": "Released",
					"type": "datetime"
				}
			]
		}
	],
	"taxonomies": [
		{
			"name": "roadmap_category",
			"label": "Roadmap categories",
			"labelSingular": "Roadmap category",
			"hierarchical": true,
			"collections": [
				"roadmap"
			],
			"terms": [
				{
					"slug": "core",
					"label": "Core"
				},
				{
					"slug": "mobile",
					"label": "Mobile"
				},
				{
					"slug": "docs",
					"label": "Docs"
				}
			]
		}
	]
}
