---
import { resolveEmDashPath } from "emdash";
import "../styles/wbcom-base.css";
import "../styles/roadmap.css";
import { strings } from "../lib/roadmap-strings";

const path = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : Astro.url.pathname;
const resolved = await resolveEmDashPath(path);
---

{
	resolved ? (
		<div class="wb roadmap" id="roadmap" data-sort="votes" aria-busy="true">
			<p id="roadmap-loading" class="wb-muted">{strings.loading}</p>
			<div id="roadmap-board" hidden></div>
		</div>
	) : null
}

<script>
	import { loadBoard } from "../lib/roadmap-board";

	if (document.getElementById("roadmap")) void loadBoard();
</script>
