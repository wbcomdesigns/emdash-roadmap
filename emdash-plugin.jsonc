{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
	"slug": "roadmap",
	"name": "Product Roadmap",
	"keywords": [
		"roadmap",
		"feature requests",
		"voting",
		"changelog",
		"feedback"
	],
	"publisher": "did:plc:2o6axbe264shvyedyhycyhya",
	"license": "MIT",
	"repo": "https://github.com/wbcomdesigns/emdash-roadmap",
	"author": {
		"name": "Wbcom Designs",
		"url": "https://wbcomdesigns.com",
		"email": "security@wbcomdesigns.com"
	},
	"security": {
		"email": "security@wbcomdesigns.com"
	},
	"description": "A public roadmap where people vote on ideas and suggest their own, with a changelog for what shipped.",
	"sections": {
		"description": { "file": "./docs/registry/description.md" },
		"installation": { "file": "./docs/registry/installation.md" },
		"faq": { "file": "./docs/registry/faq.md" },
		"changelog": { "file": "./docs/registry/changelog.md" }
	},
	"capabilities": [
		"content:read",
		"content:write",
		"content:publish",
		"schema:read",
		"taxonomies:read",
		"redirects:write",
		"email:send"
	],
	"allowedHosts": [],
	"storage": {
		"votes": {
			"indexes": [
				"item",
				"member_id",
				"createdAt",
				"visitor"
			]
		},
		"tallies": {
			"indexes": [
				"votes"
			]
		},
		"ideas": {
			"indexes": [
				"status",
				"member_id",
				"createdAt",
				"visitor"
			]
		}
	},
	"admin": {
		"pages": [
			{
				"path": "/ideas",
				"label": "Ideas",
				"icon": "sparkle",
				"group": "Roadmap"
			},
			{
				"path": "/settings",
				"label": "Settings",
				"icon": "settings",
				"group": "Roadmap"
			}
		],
		"widgets": [
			{
				"id": "waiting",
				"title": "Roadmap: waiting for you",
				"size": "half"
			}
		],
		"editorPanels": [
			{
				"id": "stage",
				"title": "Stage",
				"route": "editor_stage",
				"collections": ["roadmap"]
			}
		],
		"settingsSchema": {
			"allow_ideas": {
				"label": "Allow suggestions",
				"description": "People can send an idea. It always waits for approval.",
				"type": "boolean",
				"default": true
			},
			"who": {
				"label": "Who can vote and suggest",
				"type": "select",
				"default": "anyone",
				"options": [
					{ "value": "anyone", "label": "Anyone" },
					{ "value": "members", "label": "Signed-in members only" }
				]
			},
			"notify": {
				"label": "Email me when ideas are waiting",
				"description": "One short notice an hour. Needs a mail provider.",
				"type": "boolean",
				"default": true
			},
			"notify_to": {
				"label": "Send that email to",
				"type": "string",
				"default": ""
			}
		}
	},
	"release": {
		"artifacts": {
			"icon": {
				"file": "./icon.png"
			},
			"banner": {
				"file": "./images/banner.png"
			},
			"screenshots": [
				{ "file": "./images/screenshot-1-board.png" },
				{ "file": "./images/screenshot-2-item.png" },
				{ "file": "./images/screenshot-3-changelog.png" },
				{ "file": "./images/screenshot-4-suggest.png" },
				{ "file": "./images/screenshot-5-settings.png" }
			]
		}
	}
}
